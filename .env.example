# Copy to `.env` and fill in. `.env` is gitignored.
#
# Socrata App Token for the Chicago open-data portal. Optional for a small
# `peek`, but strongly recommended for a full backfill (otherwise you share the
# anonymous throttle and will hit 429s). Register at:
#   https://data.cityofchicago.org/profile/edit/developer_settings
#
# NOTE: only the App Token is needed. The Socrata "Secret Token" is only used
# for OAuth write/on-behalf-of flows, which this read-only project never does —
# do not store it here.
SOCRATA_APP_TOKEN=

# --- Storage layer (Phase 2) ---
# These default to the local docker-compose stack, so you can leave them unset
# for local dev. In production (Railway) DATABASE_URL is injected by the managed
# Postgres service. DSN = one connection string.
#
# DATABASE_URL=postgresql://crime:crime@localhost:5432/chicago_crime
#
# Filesystem locations for the DuckDB engine (in-process; no server):
# PARQUET_ROOT=data/parquet
# DUCKDB_PATH=data/duckdb/crime.duckdb

# --- Telemetry (Phase 4) ---
# Per-call structured logging. Defaults work with no configuration: records go
# to data/telemetry/calls-YYYY-MM-DD.jsonl, one file per day so that retention
# is a file operation rather than a migration.
#
# TELEMETRY_LOG_DIR=data/telemetry
# TELEMETRY_ENABLED=0        # stops the file sink; the stderr summary stays

# --- Eval harness (Phase 4) ---
# Only needed to run `python -m evals`, which makes real API calls and costs
# real money. The SDK also accepts an `ant auth login` profile instead. Never
# needed by the server, the pipeline, or `make ci`.
#
# ANTHROPIC_API_KEY=
# EVAL_MODEL=claude-opus-5
